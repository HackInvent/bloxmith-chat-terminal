{
  "kind": "chat_terminal",
  "version": "0.1.0",
  "bloxsmith_compatibility": [
    "1.0.9"
  ],
  "tested_with_bloxsmith": "1.0.9",
  "title": "Chat terminal",
  "ports": {
    "inputs": [
      {
        "id": 1,
        "name": "msg",
        "title": "Msg",
        "accepts": [
          "message/*",
          "application/json",
          "text/plain"
        ],
        "multiplicity": "many",
        "required": false,
        "execution_requirement": "required_for_execution"
      }
    ],
    "outputs": [
      {
        "id": 1,
        "name": "msg",
        "title": "Msg",
        "emits": [
          "application/json",
          "message/*"
        ],
        "multiplicity": "many"
      }
    ]
  },
  "config": {
    "pending_message": "",
    "pending_message_id": "",
    "pending_message_created_at": 0,
    "history_path": "user/projects/chat_terminal_history/{node_id}.jsonl",
    "ui_history": [],
    "speech_model": "gpt-4o-transcribe",
    "speech_api_key": "",
    "speech_api_base_url": "https://api.openai.com",
    "speech_language": "",
    "speech_prompt": "",
    "speech_timeout_sec": 120
  },
  "runtime": {
    "initial_state": "waiting",
    "runtime_executable": true,
    "active_worker": true,
    "generic_source": true,
    "centralized_executor": "generic",
    "centralized_dependency_mode": "any_event",
    "active_execution_policy": "on_each_event"
  },
  "ui_assets": {
    "modal": [
      {
        "kind": "css",
        "path": "assets/css/block_modal.css"
      },
      {
        "kind": "js",
        "path": "assets/js/block_modal.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ],
    "inspector_panel": [
      {
        "kind": "js",
        "path": "assets/js/properties_mount.js"
      },
      {
        "kind": "css",
        "path": "assets/css/properties.css"
      },
      {
        "kind": "js",
        "path": "assets/js/properties.js"
      }
    ]
  }
}
